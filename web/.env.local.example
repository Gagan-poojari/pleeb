# ── Clerk Auth (optional — app works without these in local dev) ──────────────
# Get these from https://dashboard.clerk.com → Create application → API Keys
# Without these, all models are unlocked and download requires no sign-in.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# After sign-in/sign-up, redirect back to the main page
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
